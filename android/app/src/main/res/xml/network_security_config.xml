<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Localhost config is NEEDED from react-native for the bundling to work  -->
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">18.194.137.13</domain>
        <domain includeSubdomains="true">18.194.137.13:3000</domain>
        <domain includeSubdomains="true">172.28.11.15</domain>
        <domain includeSubdomains="true">172.28.11.15:3000</domain>
        
        
        <trust-anchors>
            <certificates src="user"/>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
